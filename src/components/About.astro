---
const points = [
  'Multimodal Alignment & Contrastive Learning',
  'Efficient Attention Mechanisms in Transformers',
  'Human-in-the-loop Reinforcement Learning (RLHF)',
  'Representation Alignment across Domains'
];
---

<section id="about" class="scroll-mt-32">
  <div class="flex items-center gap-4 mb-12">
    <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-slate-400 shrink-0">About Me</h2>
    <div class="h-[1px] grow bg-slate-200 dark:bg-slate-800"></div>
  </div>

  <div class="grid md:grid-cols-2 gap-16 items-center">
    <div class="space-y-8">
      <p class="text-xl leading-relaxed font-light text-slate-700 dark:text-slate-300">
        I am a dedicated researcher with a passion for understanding how machines can learn more cohesive representations of our world. My work currently explores the intersection of visual perception and linguistic reasoning.
      </p>

      <ul class="space-y-4">
        {points.map((point) => (
          <li class="flex items-start gap-3 group">
            <span class="material-symbols-outlined text-primary text-xl mt-0.5 group-hover:scale-110 transition-transform">check_circle</span>
            <span class="text-slate-600 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-slate-200 transition-colors">{point}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative flex justify-center py-10">
      <div class="absolute inset-0 bg-primary/5 blur-[100px] rounded-full"></div>

      <div class="relative w-64 h-64 border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-full flex items-center justify-center animate-spin-slow">
        <div class="absolute inset-0 border border-primary/20 rounded-full animate-ping opacity-10"></div>

        <div class="w-48 h-48 border border-primary/30 rounded-full flex items-center justify-center relative">
          <div class="w-24 h-24 bg-primary/10 dark:bg-primary/20 rounded-full flex items-center justify-center animate-float">
            <span class="material-symbols-outlined text-primary text-5xl">hub</span>
          </div>

          <div class="absolute -top-6 -right-4 glass px-3 py-1.5 rounded-xl shadow-lg border border-slate-200 dark:border-slate-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-xs text-primary">visibility</span>
            <span class="text-xs font-mono font-bold">Vision</span>
          </div>

          <div class="absolute -bottom-6 -left-4 glass px-3 py-1.5 rounded-xl shadow-lg border border-slate-200 dark:border-slate-800 flex items-center gap-2">
            <span class="material-symbols-outlined text-xs text-primary">translate</span>
            <span class="text-xs font-mono font-bold">Language</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
