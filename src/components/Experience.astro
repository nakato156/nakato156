---
import type { ExperienceItem, EducationItem } from "../types";
import upc from '../assets/upc.webp';

const workExperience: ExperienceItem[] = [
  {
    id: 'w1',
    period: '2025 — Present',
    role: 'AI Developer',
    company: 'Superintendencia de Banca, Seguros y AFP',
    workType: 'presencial',
    logo: 'https://www.sbs.gob.pe/favicon.ico',
    description:
      'Automation of end-to-end testing with Cypress, managing data pipelines and Jira integration for large-scale deployments.',
  },
];

const educationItems: EducationItem[] = [
  {
    id: 'e1',
    period: 'August — 2025',
    institution: 'Pontificia Universidad Católica del Perú',
    degree: 'Artificial Intelligence (AI) Summer Camp',
    logo: 'https://www.pucp.edu.pe/favicon.ico',
  },
  {
    id: 'e2',
    period: '2022 — Present',
    institution: 'Universidad Peruana de Ciencias Aplicadas',
    degree: 'B.S. Computer Science',
    description: 'Specialization in Artificial Intelligence and Neuroscience',
    logo: upc.src,
  },
];
---
<section id="experience" class="scroll-mt-32 space-y-20">
  <!-- Experiencia Laboral -->
  <div>
    <div class="flex items-center gap-4 mb-10">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white shrink-0">Experiencia Laboral</h2>
      <div class="h-[1px] flex-grow bg-slate-200 dark:bg-slate-800"></div>
    </div>

    <div class="space-y-8">
      {workExperience.map((item) => (
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 group hover:bg-slate-50 dark:hover:bg-slate-900/40 p-4 -mx-4 rounded-2xl transition-all">
          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full glass border border-slate-200 dark:border-slate-400 flex items-center justify-center overflow-hidden shrink-0 shadow-sm bg-white dark:bg-slate-800">
              {item.logo ? (
                <img src={item.logo} alt={item.company} class="w-full h-full object-contain" />
              ) : (
                <span class="material-symbols-outlined text-primary">work</span>
              )}
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-lg text-slate-900 dark:text-white">{item.company}</h3>
                {item.workType && (
                  <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-[10px] font-medium rounded text-slate-500 uppercase tracking-tight">
                    {item.workType}
                  </span>
                )}
              </div>
              <p class="text-slate-600 dark:text-slate-400 font-medium">{item.role}</p>
              {item.description && <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">{item.description}</p>}
            </div>
          </div>
          <div class="text-slate-400 dark:text-slate-500 font-mono text-xs md:text-sm whitespace-nowrap pt-1">
            {item.period}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Educación -->
  <div>
    <div class="flex items-center gap-4 mb-10">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white shrink-0">Educación</h2>
      <div class="h-[1px] flex-grow bg-slate-200 dark:bg-slate-800"></div>
    </div>

    <div class="space-y-8">
      {educationItems.map((item) => (
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 group hover:bg-slate-50 dark:hover:bg-slate-900/40 p-4 -mx-4 rounded-2xl transition-all">
          <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full glass border-2 border-purple-600 flex items-center justify-center overflow-hidden shrink-0 shadow-sm bg-white dark:bg-slate-800">
              {item.logo ? (
                <img src={item.logo} alt={item.institution} class="w-full h-full object-cover bg-white" />
              ) : (
                <span class="material-symbols-outlined text-primary">school</span>
              )}
            </div>
            <div>
              <h3 class="font-bold text-lg text-slate-900 dark:text-white">{item.institution}</h3>
              <p class="text-slate-600 dark:text-slate-400 font-medium">{item.degree}</p>
              {item.description && <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">{item.description}</p>}
            </div>
          </div>
          <div class="text-slate-400 dark:text-slate-500 font-mono text-xs md:text-sm whitespace-nowrap pt-1">
            {item.period}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
