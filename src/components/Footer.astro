---
const year = new Date().getFullYear();
---
<footer class="border-t border-slate-100 dark:border-slate-900 py-16 px-6 mt-20">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-10">
    <div class="flex flex-col gap-2 items-center md:items-start">
      <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">
        © {year} ElNakato
      </p>
      <p class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">
        Lima, Perú • Remote
      </p>
    </div>

    <div class="flex items-center gap-8 text-sm font-semibold text-slate-400">
      <a class="hover:text-primary transition-colors" href="#projects">Projects</a>
      <a class="hover:text-primary transition-colors" href="#experience">Experience</a>
      <a class="hover:text-primary transition-colors" href="#">Blog</a>
    </div>

    <button
      id="back-to-top"
      class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-500 hover:text-primary hover:scale-110 transition-all shadow-sm"
      aria-label="Back to top"
      type="button"
    >
      <span class="material-symbols-outlined">arrow_upward</span>
    </button>
  </div>
</footer>
<script>
  const btn = document.getElementById('back-to-top');
  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
